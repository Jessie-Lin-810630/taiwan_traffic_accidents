# This .env file is for the branch, docker-integration. 
# For the branch, develop/CI, these should be transferred and saved in github secrets, and not neccessary to leave them in an .env file.
# ==== MySQL容器連線 ====
MYSQL_HOST=<docker-compose service name>
MYSQL_PORT=

# ==== MySQL容器初始化時資料庫名稱(只限一個)====
MYSQL_DATABASE=traffic_accidents

# ==== AIRFLOW跑DAG寫資料進入MySQL容器時所用的連線帳密 =====
MYSQL_USER=<docker-compose service name>
MYSQL_PASSWORD=

# ==== 容器化的MySQL server的ROOT 密碼 ====
MYSQL_ROOT_PASSWORD=

# ==== REDIS容器連線 =====
REDIS_HOST=<docker-compose service name>
REDIS_PORT=6379
REDIS_PASSWORD=

# ==== STREAMLIT容器連線 ====
STREAMLIT_USER=
STREAMLIT_PASSWORD=

# ==== 其他服務 ====
GOOGLE_MAP_API_KEY=

